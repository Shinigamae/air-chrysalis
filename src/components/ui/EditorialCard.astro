---
import StatusLabel from './StatusLabel.astro';
import type { Status } from './status';
import { withBase } from '@/config/site';

/**
 * Figma "Editorial Card" (33:49) — 16px padding, 12px gap, panel fill on a
 * 1px rule, 8px radius, with an inset media well above the text block.
 *
 * An editorial tile, not a dashboard widget. Hover reveals a cyan edge, per
 * the design direction; the whole card is the link when `href` is given.
 *
 * The homepage cards (Figma 4:71-4:102) are this same pattern with three
 * extra fields, so they are props here rather than a second card component:
 *   subtitle  a muted qualifier under the title ("Software / Projects")
 *   summary   a sentence of description
 *   action    the "VIEW →" affordance, pinned to the bottom of the card
 *
 * Two slots take content the card cannot type:
 *   tags      a row under the title — the Gaming Log's platform chips
 *   meta      leads the metadata line — the Reading Log's stars
 */
interface Props {
  kicker: string;
  title: string;
  subtitle?: string;
  summary?: string;
  meta?: string;
  action?: string;
  href?: string;
  image?: string;
  imageAlt?: string;
  status?: Status;
  /** Label for the empty media plate — "BOOK COVER", "SCREENSHOTS". */
  mediaLabel?: string;
  /**
   * Plate shape. `wide` is the Figma component (388x150). `portrait` is for
   * book covers, which a wide plate crops into an unreadable band.
   */
  mediaAspect?: 'wide' | 'portrait';
  /**
   * `compact` is the same card a quarter smaller — tighter padding and a
   * step down the type scale, so four fit a row where three did. Used by
   * the Reading Log, where the cover is the content and the card around it
   * was mostly air.
   */
  density?: 'default' | 'compact';
  /**
   * Marks the card out with a travelling highlight around its edge, and a
   * badge beside the status. The Gaming Log's two: a platinum trophy, and
   * 100% completion without one.
   */
  accent?: 'platinum' | 'gold';
  /** Heading level for the card title within the page hierarchy. */
  as?: 'h2' | 'h3' | 'h4';
}

// Written out rather than interpolated so Tailwind can see both classes.
const PLATE = {
  wide: 'aspect-[388/150]',
  portrait: 'aspect-[3/4]',
} as const;

const ACCENT = {
  platinum: {
    label: 'PLATINUM',
    ring: 'card-shine card-shine--platinum',
    badge: 'border-platinum/40 bg-platinum/10 text-platinum',
  },
  gold: {
    label: '100%',
    ring: 'card-shine card-shine--gold',
    badge: 'border-gold/45 bg-gold/12 text-gold',
  },
} as const;

const {
  kicker,
  title,
  subtitle,
  summary,
  meta,
  action,
  href,
  image,
  imageAlt = '',
  status,
  mediaLabel = 'IMAGE / MEDIA',
  mediaAspect = 'wide',
  density = 'default',
  accent,
  as: Tag = 'h3',
}: Props = Astro.props;

const compact = density === 'compact';
const mark = accent ? ACCENT[accent] : undefined;
const hasMeta = Boolean(meta) || Astro.slots.has('meta');
---

<article
  class:list={[
    'group relative flex h-full flex-col rounded-standard border bg-panel transition-colors duration-[var(--duration-base)] ease-[var(--ease-technical)]',
    compact ? 'gap-1 p-1.5' : 'gap-1.5 p-2',
    // An accent card keeps its own edge on hover; the cyan would fight it.
    mark ? mark.ring : 'border-line hover:border-signal focus-within:border-signal',
  ]}
>
  <div
    class:list={[
      'flex items-center justify-center overflow-hidden border border-line bg-well',
      PLATE[mediaAspect],
    ]}
  >
    {
      image ? (
        <img
          src={withBase(image)}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      ) : (
        <span class="type-micro">{mediaLabel}</span>
      )
    }
  </div>

  <div class="flex items-center justify-between gap-1">
    <p class="type-micro text-signal">{kicker}</p>
    <div class="flex shrink-0 items-center gap-0.5">
      {
        mark && (
          <span
            class:list={[
              'type-meta inline-flex h-3 items-center gap-0.5 rounded-compact border px-1',
              mark.badge,
            ]}
          >
            <span aria-hidden="true">◆</span>
            {mark.label}
          </span>
        )
      }
      {status && <StatusLabel status={status} />}
    </div>
  </div>

  <div class="flex flex-col gap-0.5">
    {/* Clamped in compact: a full Goodreads title runs to three lines and
        pushes the card taller than the cover it belongs to. */}
    <Tag class:list={[compact ? 'type-brand-sm line-clamp-2' : 'type-title']}>
      {
        href ? (
          <a
            href={href}
            class="after:absolute after:inset-0 after:content-[''] focus:outline-none"
          >
            {title}
          </a>
        ) : (
          title
        )
      }
    </Tag>
    {
      subtitle && (
        <p class:list={[compact ? 'type-fine line-clamp-1 text-muted' : 'type-caption']}>
          {subtitle}
        </p>
      )
    }
  </div>

  <slot name="tags" />

  {summary && <p class:list={['type-fine', compact && 'line-clamp-3']}>{summary}</p>}

  {
    hasMeta && (
      <p class="type-meta flex flex-wrap items-center gap-1">
        <slot name="meta" />
        {meta}
      </p>
    )
  }

  {
    action && (
      <p
        aria-hidden="true"
        class="type-micro mt-auto pt-1 text-signal transition-opacity duration-[var(--duration-base)] ease-[var(--ease-technical)] group-hover:opacity-80"
      >
        {action}
      </p>
    )
  }
</article>
