---
import { statusTone, type Status } from './status';

/**
 * Figma "Status Label" (33:41) — Live / Archive / Draft variants.
 * 24px tall, 8px horizontal padding, 4px radius, 1px rule, no fill.
 * Live is cyan; the rest are muted.
 */
interface Props {
  status: Status;
  /** Overrides the default label text ("LIVE", "ARCHIVE", "DRAFT"). */
  label?: string;
  /**
   * Optional hook for edit mode, which rewrites the label in place after a save.
   * Only the tone lags behind — the colour is a build-time class, so a status
   * changed here reads correctly and is still tinted as what it was until the
   * next deploy.
   */
  field?: string;
}

const { status, label, field } = Astro.props;
---

<span
  class:list={[
    'type-meta inline-flex h-3 items-center justify-center rounded-compact border border-line px-1',
    statusTone[status],
  ]}
  data-edit-field={field}
>
  {label ?? status.toUpperCase()}
</span>
