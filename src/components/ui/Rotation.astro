---
import {
  artistsOf,
  byRank,
  durationOf,
  embedUrl,
  rankOf,
  sourceLabel,
  syncedLabel,
  type Rotation,
} from '@/config/music';

/**
 * ON ROTATION — the play-count chart, with Spotify's embed as the player.
 *
 * The shape follows the Gaming Log's "CURRENTLY PLAYING" block, which is the
 * pattern this site already uses for "one thing featured, the rest listed":
 * the loaded track is given the art and the player, and the whole chart is
 * ranked beside it.
 *
 * Playback is Spotify's iframe and nothing else. Their Web API stopped
 * handing out 30-second preview URLs to new apps in late 2024, so a custom
 * `<audio>` player has nothing to play — and full tracks outside their player
 * are not something they licence anyway. What the embed gives a signed-in
 * listener is the whole song; everyone else gets the preview. Their rule, and
 * it cannot be styled away.
 *
 * Every row is a real link to the track on Spotify, so the section works with
 * no JavaScript: a chart that links out, which is the honest fallback. The
 * script below upgrades a plain click to "load it here instead" and leaves a
 * modified click — new tab, middle button — alone.
 */
interface Props {
  data: Rotation['data'];
}

const { data }: Props = Astro.props;

const tracks = [...data.tracks].sort(byRank);
const [lead, ...rest] = tracks;
const synced = syncedLabel(data.syncedAt);

/** Shared by the feature plate and the row thumbnails. */
const PLATE = 'overflow-hidden border border-line bg-well';

/**
 * `data-active` carries the styling and `aria-current` the meaning. One
 * attribute could do both, but every `aria-current` variant in Tailwind is an
 * arbitrary one, and this row has several rules keyed off the state.
 *
 * Every one of them is written out in full below rather than built from a
 * shared prefix: Tailwind scans the source as text, so an interpolated class
 * name is a class name that never reaches the stylesheet. `EditorialCard`
 * carries the same warning over its plate sizes.
 */
---

{
  lead && (
    <div class="mt-5" data-rotation>
      {/* PageHeader carries the section's title on the page; what belongs
          here is the provenance — which chart this is, and as of when. */}
      <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
        <p class="type-micro text-signal">{sourceLabel(data)}</p>
        {synced && <p class="type-meta">AS OF {synced}</p>}
      </div>

      <div class="mt-3 grid grid-cols-1 gap-3 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)]">
        {/* --- The loaded track, and the player ----------------------- */}
        <div class="flex flex-col gap-2">
          <div class:list={['relative aspect-square rounded-standard', PLATE]}>
            <span class="type-micro absolute inset-0 flex items-center justify-center">
              ALBUM ART
            </span>
            {lead.art && (
              <img
                data-art
                src={lead.art}
                alt=""
                loading="lazy"
                decoding="async"
                class="relative h-full w-full object-cover transition-opacity duration-[var(--duration-slow)] ease-[var(--ease-technical)]"
              />
            )}
          </div>

          <div class="flex flex-col gap-0.5">
            <p class="type-title" data-lead-title>
              {lead.title}
            </p>
            <p class="type-meta" data-lead-artist>
              {artistsOf(lead)}
            </p>
          </div>

          {/*
            152 is Spotify's own standard track embed height. The rounding is
            inline because the corner belongs to their iframe, not to a
            wrapper we could style — a bordered box around it reads as a
            double frame, so the player is left to be the plate itself.
          */}
          <iframe
            data-player
            src={embedUrl(lead.id)}
            title="Spotify player"
            width="100%"
            height="152"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            style="border: 0; border-radius: var(--radius-standard); display: block;"
          />
        </div>

        {/* --- The chart ---------------------------------------------- */}
        <div class="flex flex-col gap-1.5">
          <ol class="flex flex-col">
            {tracks.map((track, i) => (
              <li>
                <a
                  href={track.url}
                  rel="noopener external"
                  target="_blank"
                  data-track
                  data-id={track.id}
                  data-title={track.title}
                  data-artist={artistsOf(track)}
                  data-art={track.art ?? ''}
                  data-active={i === 0 ? 'true' : undefined}
                  aria-current={i === 0 ? 'true' : undefined}
                  class:list={[
                    'group grid grid-cols-[1.75rem_auto_minmax(0,1fr)_auto] items-center gap-2 rounded-compact border border-transparent px-1 py-1',
                    // The album takes the slack at wide sizes. Without it the
                    // duration sits half a metre from the title it belongs to.
                    'lg:grid-cols-[1.75rem_auto_minmax(0,1.4fr)_minmax(0,1fr)_auto]',
                    'transition-[background-color,border-color] duration-[var(--duration-base)] ease-[var(--ease-technical)]',
                    'hover:border-line hover:bg-panel focus-visible:border-signal focus-visible:outline-none',
                    'data-[active=true]:border-line data-[active=true]:bg-panel',
                  ]}
                >
                  {/* The rank becomes a meter on the loaded track. Both are
                      rendered and CSS picks between them: swapping nodes in
                      script would leave the no-JS page showing the wrong one. */}
                  <span class="type-meta tabular-nums text-muted group-data-[active=true]:hidden">
                    {rankOf(track)}
                  </span>
                  <span
                    class="eq hidden text-signal group-data-[active=true]:inline-flex"
                    aria-hidden="true"
                  ><span /><span /><span /></span>

                  <span class:list={['h-4 w-4 shrink-0 rounded-compact', PLATE]}>
                    {track.art && (
                      <img
                        src={track.art}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover"
                      />
                    )}
                  </span>

                  <span class="min-w-0">
                    <span class="type-fine block truncate group-data-[active=true]:text-signal">
                      {track.title}
                    </span>
                    <span class="type-meta block truncate">{artistsOf(track)}</span>
                  </span>

                  <span class="type-meta hidden min-w-0 truncate lg:block">
                    {track.album}
                    {track.releaseYear && ` · ${track.releaseYear}`}
                  </span>

                  <span class="type-meta tabular-nums">{durationOf(track.durationMs)}</span>
                </a>
              </li>
            ))}
          </ol>

          <p class="type-micro">
            {rest.length > 0 && 'CLICK A TRACK TO LOAD IT · '}CTRL-CLICK OPENS SPOTIFY
          </p>
        </div>
      </div>
    </div>
  )
}

{/*
  Progressive enhancement, deliberately not a React island — the same call
  `STATUS.md` records for the collection filters. There is no state worth
  putting in a component tree: one selected row, and an iframe that is told
  what to load.

  Swapping `src` reloads the embed rather than driving it through Spotify's
  IFrame API. That API would allow one-click play, but it means pulling their
  script into the page; this way the only third-party code here is the iframe
  the section exists for. The cost is one press of Spotify's own play button.
*/}
<script is:inline>
  (() => {
    const root = document.querySelector('[data-rotation]');
    if (!root) return;

    const player = root.querySelector('[data-player]');
    const art = root.querySelector('[data-art]');
    const title = root.querySelector('[data-lead-title]');
    const artist = root.querySelector('[data-lead-artist]');
    const rows = root.querySelectorAll('[data-track]');

    const swapArt = (src) => {
      if (!art || !src || art.src === src) return;
      const show = () => {
        art.style.opacity = '1';
      };
      art.style.opacity = '0';
      art.src = src;
      if (typeof art.decode === 'function') art.decode().then(show, show);
      else art.addEventListener('load', show, { once: true });
    };

    rows.forEach((row) => {
      row.addEventListener('click', (event) => {
        // A modified click is someone asking for a new tab. Let it through to
        // the href, which is the track on Spotify.
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        event.preventDefault();

        rows.forEach((other) => {
          other.removeAttribute('data-active');
          other.removeAttribute('aria-current');
        });
        row.setAttribute('data-active', 'true');
        row.setAttribute('aria-current', 'true');

        if (player) player.src = `https://open.spotify.com/embed/track/${row.dataset.id}?theme=0`;
        if (title) title.textContent = row.dataset.title;
        if (artist) artist.textContent = row.dataset.artist;
        swapArt(row.dataset.art);
      });
    });
  })();
</script>
