---
import { Image } from 'astro:assets';
import { site, headerNavigation, isActive, isGroupActive, withBase } from '@/config/site';
import NavLink from './NavLink.astro';
import SessionControl from './SessionControl';
import ThemeToggle from './ThemeToggle.astro';
import { hasBackend } from '@/lib/api';
import mark from '@/assets/logo-trans.png';

/**
 * Desktop header — Figma "02 — Homepage" › Header (4:39).
 *
 * Brand lockup left, destinations centre, external link right. 56px tall,
 * seated on the canvas with a 1px bottom rule. Hidden below `md`, where
 * MobileNavigation takes over rather than this shrinking down.
 */
interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<header class="hidden border-b border-line bg-canvas md:block">
  <div
    class="layout-container flex items-center justify-between gap-3"
    style="min-height: var(--shell-header)"
  >
    {/*
      The mark is `logo-trans.png` rather than `logo.png`: the latter is
      matted onto opaque black, which reads as a square on the canvas.
      Decorative — the wordmark beside it already names the site.

      Imported, so astro:assets serves a 32px WebP with a 2x companion
      instead of the 465px source on every page in the site.
    */}
    <a
      href={withBase('/')}
      class="group flex items-center gap-1.5 py-1 transition-opacity duration-[var(--duration-base)] ease-[var(--ease-technical)] hover:opacity-80"
    >
      <Image
        src={mark}
        alt=""
        width={32}
        height={32}
        densities={[1, 2]}
        format="webp"
        quality={90}
        loading="eager"
        class="brand-mark h-4 w-4 shrink-0 object-contain"
      />
      <span class="flex flex-col gap-px">
        <span class="type-brand">{site.name}</span>
        <span class="type-meta">{site.tagline}</span>
      </span>
    </a>

    {/*
      A group with pages under it opens a menu on hover and on focus — a
      keyboard tab onto LIFESTYLE shows the list it is about to tab through.
      The label is still a link to the hub, so a reader who never opens the
      menu loses nothing.
    */}
    <nav aria-label="Main" class="flex items-center gap-5 lg:gap-8">
      {
        headerNavigation.map((group) => (
          <div class="group/menu relative">
            <NavLink
              href={withBase(group.href)}
              label={group.label}
              accent={group.accent}
              active={isGroupActive(pathname, group)}
            />
            {group.children.length > 0 && (
              <ul class="invisible absolute left-1/2 top-full z-40 m-0 flex min-w-[11rem] -translate-x-1/2 list-none flex-col gap-0.5 rounded-standard border border-line bg-panel p-1.5 opacity-0 transition-opacity duration-[var(--duration-base)] ease-[var(--ease-technical)] group-hover/menu:visible group-hover/menu:opacity-100 group-focus-within/menu:visible group-focus-within/menu:opacity-100">
                {group.children.map((child) => (
                  <li>
                    <NavLink
                      href={withBase(child.href)}
                      label={child.label}
                      accent={child.accent}
                      active={isActive(pathname, child.href)}
                      class="w-full px-1"
                    />
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </nav>

    {/*
      The third slot used to be the ↗ out to GitHub; that link moved to the
      footer, which is where a site's own credits sit, and this is the door in.

      The switch between the two grounds shares the slot, ahead of the door —
      the ground is a setting and the session is not, so the reader passes the
      first on the way to the second rather than finding it behind them.

      The width is reserved rather than fitted. The row is `justify-between`,
      so a slot that changes size drags the navigation across with it — and
      the door has four states (nothing, SIGN IN, a name, a name being
      resolved) that land at different page loads. 7rem is the reserve the
      door already had plus the switch and the gap, and it is now on the pair
      rather than on the door alone: the destinations do not move when a
      session resolves, and do not sit in a different place on the Pages
      mirror, which has no backend and renders the door empty. The switch is
      right-aligned inside it, so on that mirror it lands flush against the
      margin instead of floating clear of it.
    */}
    <div class="flex min-w-[7rem] items-center justify-end gap-2">
      <ThemeToggle />
      {hasBackend && <SessionControl client:idle />}
    </div>
  </div>
</header>
