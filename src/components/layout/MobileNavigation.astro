---
import { Image } from 'astro:assets';
import { site, navigation, entryFor, withBase } from '@/config/site';
import MobileMenu from './MobileMenu';
import ThemeToggle from './ThemeToggle.astro';
import mark from '@/assets/logo-trans.png';

/**
 * Mobile header — Figma "Mobile Navigation" (33:103).
 *
 * 64px, panel ground, 1px rule: brand left, current section centre in cyan,
 * MENU right. A separate structure from the desktop header rather than a
 * squeezed version of it.
 */
interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const current = entryFor(pathname);
---

<header
  class="border-b border-line bg-panel md:hidden"
  style="min-height: var(--shell-mobile-header)"
>
  <div
    class="flex items-center justify-between gap-2 px-2"
    style="min-height: var(--shell-mobile-header)"
  >
    <a
      href={withBase('/')}
      class="flex items-center gap-1 transition-opacity duration-[var(--duration-base)] ease-[var(--ease-technical)] hover:opacity-80"
    >
      <Image
        src={mark}
        alt=""
        width={28}
        height={28}
        densities={[1, 2]}
        format="webp"
        quality={90}
        loading="eager"
        class="brand-mark h-3.5 w-3.5 shrink-0 object-contain"
      />
      <span class="type-brand-sm">{site.name}</span>
    </a>

    {/* The section's own accent, as in the desktop header — see NavLink. */}
    {current && (
      <span
        class="type-meta text-[var(--nav-accent,var(--color-signal))]"
        style={`--nav-accent: var(--color-word-${current.accent}, var(--color-signal))`}
      >
        {current.label}
      </span>
    )}

    {/*
      The switch travels with MENU rather than going inside the overlay. The
      desktop header keeps it one tap from anywhere, and a setting that
      changes the whole page should not need the page covered up first — the
      door does, because signing in is a journey, and this is one tap.
    */}
    <div class="flex items-center gap-1">
      <ThemeToggle />
      <MobileMenu client:load entries={navigation} pathname={pathname} />
    </div>
  </div>
</header>
