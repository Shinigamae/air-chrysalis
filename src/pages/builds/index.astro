---
import { getCollection } from 'astro:content';
import AppShell from '@/layouts/AppShell.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import EditorialCard from '@/components/ui/EditorialCard.astro';
import { entryFor, withBase } from '@/config/site';

/**
 * Builds — Figma "03 — Content Systems" panel A (11:79), rendered as the
 * editorial index: a grid of Editorial Cards.
 *
 * The facet rail that sat beside the section header is deliberately empty.
 * It used to filter by status, which stopped meaning anything once the
 * archive became an import of published posts — every entry is `archive`, so
 * the control offered one real choice. The slot is reserved for a facet worth
 * having (series or manufacturer are the obvious candidates); the machinery
 * is still in `collection-filter.ts` and on the games index.
 */
const entry = entryFor(Astro.url.pathname)!;
const builds = (await getCollection('builds')).sort(
  (a, b) => a.data.index - b.data.index,
);

/**
 * "MG / 1:100", or whichever half is known. Third-party kits often have no
 * grade and non-scale kits no scale, so an unconditional join would leave a
 * dangling separator on a third of the archive.
 */
const kickerFor = (b: (typeof builds)[number]) =>
  [b.data.grade, b.data.scale].filter(Boolean).join(' / ') || b.data.kind;
---

<AppShell topBarMeta={`INDEX / ${String(builds.length).padStart(3, '0')}`}>
  <PageHeader
    eyebrow={`${entry.index} / ${entry.context}`}
    title={entry.label}
    summary={entry.summary}
  />

  <div class="mt-8 flex flex-col gap-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <SectionHeader index="01" title="BUILD ARCHIVE" />
      <p class="type-meta">{builds.length} ENTRIES</p>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        builds.map((build) => (
          <EditorialCard
            kicker={kickerFor(build)}
            title={build.data.title}
            subtitle={[build.data.series, build.data.manufacturer]
              .filter(Boolean)
              .join(' · ')}
            summary={build.data.summary}
            meta={`${String(build.data.index).padStart(2, '0')} — ${build.data.kind} / ${build.data.buildDate}`}
            href={withBase(`/builds/${build.id}`)}
            action="ARCHIVE DETAIL →"
            image={build.data.hero}
            imageAlt={build.data.hero ? build.data.title : ''}
          />
        ))
      }
    </div>
  </div>
</AppShell>
