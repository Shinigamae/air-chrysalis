---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import AppShell from '@/layouts/AppShell.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import StatusPanel from '@/components/ui/StatusPanel.astro';
import SocialCard from '@/components/ui/SocialCard.astro';
import StatusEditor from '@/components/edit/StatusEditor';
import {
  hero,
  whatIDo,
  selectedWork,
  career,
  lifestyle,
  workshopDoor,
  contact,
  currentStatus,
  type StatusItem,
} from '@/config/home';
import { byName } from '@/config/clients';
import { byRecency } from '@/config/music';
import { yearsInSoftware } from '@/config/resume';
import { listedProfiles } from '@/config/social';
import { site, withBase } from '@/config/site';
import { lifestyleStats, statFor } from '@/lib/lifestyle';
import { hasBackend } from '@/lib/api';

/**
 * Home — the redesign's funnel: identity → what I do → selected work →
 * career → lifestyle → now → contact. Professional first, by weight as well
 * as by order; the archive is one compact strip, and music is one card.
 */
const [games, books, music, clients, projects] = await Promise.all([
  getCollection('games'),
  getCollection('books'),
  getCollection('music'),
  getCollection('clients'),
  getCollection('projects'),
]);
const stats = await lifestyleStats();

/**
 * PLAYING and READING come from the collections rather than from config. The
 * syncs already mark what is current, and a second hand-typed copy of the
 * answer only rots.
 */
const playing = games.find((game) => game.data.current);
// Several books can be on the shelf at once; the panel has room for one, so
// it takes whichever was picked up most recently.
const reading = books
  .filter((book) => book.data.current)
  .sort((a, b) => (b.data.addedOn ?? '').localeCompare(a.data.addedOn ?? ''))[0];

// Order matters: the panel fills down each column before moving across, so
// this is BUILDING / PLAYING, then READING / NEXT BUILD.
const statusItems: StatusItem[] = [
  currentStatus.building,
  { label: 'PLAYING', value: playing?.data.title ?? currentStatus.idle },
  { label: 'READING', value: reading?.data.title ?? currentStatus.idle },
  currentStatus.nextBuild,
];

/** The last playlist reached for — the whole shelf lives on /now. */
const onRotation = music.flatMap((entry) => entry.data.playlists).sort(byRecency)[0];

/**
 * Selected work: clients by name, then the chosen projects in the order
 * config names them. Never by date — a dates-based order puts the current
 * engagement first. Role titles only, as the client cards print them.
 */
const work = [
  ...[...clients].sort(byName).map((client) => ({
    name: client.data.name,
    role: client.data.roles.map((role) => role.title).join(' · '),
    domain: client.data.industry,
    logo: client.data.logo,
    href: withBase(`/workshop#${client.id}`),
  })),
  ...selectedWork.projects.flatMap((id) => {
    const project = projects.find((entry) => entry.id === id);
    return project
      ? [
          {
            name: project.data.title,
            role: project.data.role,
            domain: project.data.domain ?? project.data.subtitle,
            logo: undefined,
            href: withBase(`/workshop#${project.id}`),
          },
        ]
      : [];
  }),
];

/**
 * The brand words, kept beside the role as the second thing read. Each still
 * opens the section it names, and lights in that section's colour.
 */
const words = [workshopDoor, ...lifestyle.cards.filter((card) => card.kicker !== 'TRAVEL')].map(
  (door) => ({
    key: door.kicker.toLowerCase(),
    word: `${door.kicker}.`,
    href: withBase(door.href),
    label: door.title,
  }),
);

const wordCss = words
  .map(
    ({ key }) => `
    [data-hero-word='${key}']:is(:hover, :focus-visible) {
      background-image: linear-gradient(100deg, var(--color-word-${key}) 15%, var(--color-word-${key}-end) 85%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }`,
  )
  .join('\n');

const socials = listedProfiles();
const years = yearsInSoftware();

/**
 * Who this site belongs to, for search engines — schema.org's `Person`. A
 * job title and no employer: the role is the hero's own line, and an
 * employer or client would say which engagement is current.
 */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  // The brand is uppercase by house style; a name is not.
  name: 'Shinigamae',
  jobTitle: 'Technical Project Manager',
  url: new URL(withBase('/'), Astro.site).href,
  image: new URL(withBase('/icon-512.png'), Astro.site).href,
  sameAs: [
    ...socials.flatMap((profile) => (profile.href ? [profile.href] : [])),
    site.external.href,
  ],
};

const button =
  'type-nav inline-flex h-5 w-fit items-center justify-center rounded-compact border px-2 transition-colors duration-[var(--duration-base)] ease-[var(--ease-technical)]';
const primaryButton = `${button} border-signal text-signal hover:bg-signal/10`;
const quietButton = `${button} border-line text-ink hover:border-signal hover:text-signal`;
const tile =
  'flex h-full flex-col gap-1 rounded-standard border border-line bg-panel p-3 no-underline transition-colors duration-[var(--duration-base)] ease-[var(--ease-technical)]';
---

<AppShell showTopBar={false}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(person)} />

  {/* --- 01 Hero: the role first ------------------------------------- */}
  <section
    class="grid grid-cols-1 items-end gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,300px)] lg:gap-8"
  >
    <div class="flex flex-col gap-3">
      <p class="type-meta text-signal">{hero.eyebrow}</p>
      <h1 class="m-0 font-display text-[clamp(32px,5.4vw,66px)] leading-[0.98] font-medium text-ink">
        <span class="block">{hero.title[0]}</span>
        <span class="block bg-linear-to-r from-(--color-word-code) to-(--color-word-code-end) bg-clip-text text-transparent">
          {hero.title[1]}
        </span>
      </h1>
      <p class="type-lead max-w-[46ch]">{hero.lead}</p>
      <p class="type-meta">
        <span class="text-ink">{years}+ YEARS IN SOFTWARE</span> · {hero.focus}
      </p>
      <div class="mt-1 flex flex-wrap gap-1">
        <a href={withBase(hero.primary.href)} class={primaryButton}>{hero.primary.label}</a>
        <a href={withBase(hero.secondary.href)} class={quietButton}>{hero.secondary.label}</a>
      </div>
    </div>

    {/* The brand statement, now second. Each word is a door to its section. */}
    <div class="flex flex-col gap-2 border-line lg:border-l lg:pl-5">
      <p class="type-display m-0 flex flex-col">
        {
          words.map(({ key, word, href, label }) => (
            <a
              href={href}
              data-hero-word={key}
              aria-label={`${word} ${label}`}
              class="block w-fit no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-signal"
            >
              {word}
            </a>
          ))
        }
      </p>
      <p class="type-fine">{hero.intro}</p>
    </div>
  </section>

  {/* --- 02 What I do -------------------------------------------------- */}
  <section class="mt-8">
    <PageHeader variant="section" eyebrow={whatIDo.eyebrow} title={whatIDo.title} summary={whatIDo.summary} />
    <ol class="m-0 mt-5 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2 xl:grid-cols-5">
      {
        whatIDo.items.map((item, i) => (
          <li class={tile}>
            <span class="type-meta text-signal">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="type-micro text-ink">{item.title}</h3>
            <p class="type-fine">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* --- 03 Selected work ---------------------------------------------- */}
  <section class="mt-8">
    <PageHeader
      variant="section"
      eyebrow={selectedWork.eyebrow}
      title={selectedWork.title}
      summary={selectedWork.summary}
    />
    <ul class="m-0 mt-5 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-2 lg:grid-cols-3">
      {
        work.map((item) => (
          <li>
            <a href={item.href} class={`${tile} hover:border-signal`}>
              {/*
                The mark on the same light plate the Workshop's client card
                uses — these logos are drawn for white, and Menlo's near-black
                wordmark vanishes on the panel. Projects have no mark; the
                slot keeps its height so the grid's titles still line up.
              */}
              <div class="mb-1 flex h-6 items-center">
                {item.logo ? (
                  <span class="flex h-full items-center rounded-compact border border-line bg-plate px-1.5">
                    <Image
                      src={item.logo}
                      alt={`${item.name} logo`}
                      height={56}
                      densities={[1, 2]}
                      format="webp"
                      quality={90}
                      loading="lazy"
                      decoding="async"
                      class="h-3.5 w-auto max-w-[160px] object-contain"
                    />
                  </span>
                ) : (
                  <span class="type-micro text-muted">PERSONAL PROJECT</span>
                )}
              </div>
              <h3 class="type-subhead">{item.name.toUpperCase()}</h3>
              {item.role && <p class="type-meta text-ink">{item.role}</p>}
              {item.domain && <p class="type-fine">{item.domain}</p>}
              <span class="type-micro mt-auto pt-1 text-signal">READ CASE STUDY →</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a href={withBase('/workshop')} class={`${quietButton} mt-3`}>{selectedWork.action}</a>
  </section>

  {/* --- 04 Career: progression, not dates ----------------------------- */}
  <section class="mt-8">
    <PageHeader variant="section" eyebrow={career.eyebrow} title={career.title} summary={career.summary} />
    <ol class="m-0 mt-5 grid list-none grid-cols-1 gap-3 p-0 md:grid-cols-3">
      {
        career.steps.map((step, i) => (
          <li class="flex flex-col gap-1 border-t border-line pt-2">
            <span class="type-meta text-signal">
              {i === 0 ? 'START' : '→'}
            </span>
            <h3 class="type-micro text-ink">{step.title}</h3>
            <p class="type-fine">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* --- 05 Lifestyle: compact, by design ------------------------------ */}
  <section class="mt-8">
    <PageHeader variant="section" eyebrow={lifestyle.eyebrow} title={lifestyle.title} summary={lifestyle.summary} />
    <ul class="m-0 mt-5 grid list-none grid-cols-2 gap-3 p-0 lg:grid-cols-4">
      {
        lifestyle.cards.map((card) => {
          const stat = statFor(stats, card.href);
          const key = card.kicker === 'TRAVEL' ? 'journeys' : card.kicker.toLowerCase();
          return (
            <li>
              <a
                href={withBase(card.href)}
                style={`--tile: var(--color-word-${key})`}
                class="flex h-full flex-col gap-0.5 rounded-standard border border-line p-2 no-underline transition-colors duration-[var(--duration-base)] ease-[var(--ease-technical)] hover:border-[var(--tile)]"
              >
                <span class="type-micro text-[var(--tile)]">{card.kicker}</span>
                <span class="type-display">{stat?.value}</span>
                <span class="type-meta">{stat?.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <a href={withBase('/lifestyle')} class={`${quietButton} mt-3`}>{lifestyle.action}</a>
  </section>

  {/* --- 06 Now --------------------------------------------------------- */}
  <section class="mt-8">
    <PageHeader variant="section" eyebrow={currentStatus.eyebrow} title="NOW" summary="What this week looks like." />
    <div class="mt-5 grid grid-cols-1 gap-3 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div>
        <StatusPanel label={currentStatus.label} headline={currentStatus.headline} items={statusItems} />
        {/* PLAYING and READING are not editable: the collections already know
            the answer, and a hand-typed one goes stale silently. */}
        {hasBackend && (
          <StatusEditor
            client:idle
            building={currentStatus.building.value}
            nextBuild={currentStatus.nextBuild.value}
          />
        )}
      </div>
      {
        onRotation && (
          <a href={withBase('/now#rotation')} class={`${tile} flex-row items-center gap-2 hover:border-signal`}>
            {onRotation.image && (
              <img
                src={onRotation.image}
                alt=""
                width="64"
                height="64"
                loading="lazy"
                class="h-8 w-8 shrink-0 rounded-compact object-cover"
              />
            )}
            <span class="flex min-w-0 flex-col gap-0.5">
              <span class="type-micro text-signal">ON ROTATION</span>
              <span class="type-subhead truncate">{onRotation.name}</span>
              <span class="type-micro">LISTEN →</span>
            </span>
          </a>
        )
      }
    </div>
    <a href={withBase('/now')} class={`${quietButton} mt-3`}>MORE ON NOW →</a>
  </section>

  {/* --- 07 Contact ----------------------------------------------------
      The page's last word is a way to reply. LinkedIn rather than a form or
      an address — see `site.contact`. The social cards sit under it as the
      rest of the ways to find me; they leave the site, so they are
      `SocialCard` and never say VIEW →. */}
  <section class="mt-8">
    <p class="type-meta text-signal">{contact.eyebrow}</p>
    <h2 class="type-display mt-2 max-w-[26ch]">
      {contact.title[0]} <span class="text-signal">{contact.title[1]}</span>
    </h2>
    <p class="type-lead mt-2">{contact.summary}</p>
    <div class="mt-3 flex flex-wrap gap-1">
      <a href={site.contact.href} rel="me noopener" target="_blank" class={primaryButton}>
        {site.contact.label.toUpperCase()} ↗
      </a>
      <a href={withBase('/resume')} class={quietButton}>RESUME →</a>
      <a href={site.external.href} rel="me noopener" target="_blank" class={quietButton}>
        {site.external.label.toUpperCase()} ↗
      </a>
    </div>

    {
      socials.length > 0 && (
        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {socials.map((profile) => (
            <SocialCard profile={profile} />
          ))}
        </div>
      )
    }
  </section>

  <style is:inline set:html={wordCss} />
</AppShell>
