---
import AppShell from '@/layouts/AppShell.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import StatusLabel from '@/components/ui/StatusLabel.astro';
import { entryFor } from '@/config/site';

/**
 * Lab — the one section with no design and no content model.
 *
 * FIGMA.md lists LAB in the information architecture and the routing, so the
 * route and nav entry stay. Until it has a purpose, this is an honest empty
 * state rather than a debug marker: it says what the section is for and that
 * there is nothing in it yet.
 *
 * When Lab gets a purpose, this becomes a collection like the others.
 */
const entry = entryFor(Astro.url.pathname)!;
---

<AppShell topBarMeta="INDEX / 000">
  <PageHeader
    eyebrow={`${entry.index} / ${entry.context}`}
    title={entry.label}
    summary={entry.summary}
  />

  <div
    class="mt-8 flex flex-col items-start gap-2 rounded-standard border border-line bg-panel p-3"
  >
    <div class="flex items-center gap-2">
      <StatusLabel status="draft" label="EMPTY" />
      <p class="type-meta">NO ENTRIES YET</p>
    </div>
    <p class="type-fine max-w-prose">
      Things land here when they are too small to be a project and too unfinished
      to be a build. Nothing has qualified yet.
    </p>
  </div>
</AppShell>
