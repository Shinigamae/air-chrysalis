---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import AppShell from '@/layouts/AppShell.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import EditorialCard from '@/components/ui/EditorialCard.astro';
import StatusLabel from '@/components/ui/StatusLabel.astro';
import ReadingTimeline from '@/components/ui/ReadingTimeline.astro';
import StarRating from '@/components/ui/StarRating.astro';
import Pager from '@/components/ui/Pager.astro';
import { entryFor, withBase } from '@/config/site';

/**
 * Books — Figma "03 — Content Systems" panel C (11:98-11:108):
 * current book beside the cover, then the reading timeline, then the index.
 *
 * The design is explicit that a short personal thought replaces a generic
 * review score, so the thought is the prominent text and the rating is
 * relegated to metadata.
 *
 * Paginated because the shelf is imported wholesale from Goodreads and runs
 * to hundreds of entries: as one page it rendered close to a megabyte of HTML
 * and several hundred cover images, and it only grows. The feature slot and
 * the timeline belong to the reading year, so they stay on the first page.
 */

export const getStaticPaths = (async ({ paginate }) => {
  // Defined in here, not at module scope: Astro hoists getStaticPaths into a
  // scope of its own, where anything declared alongside it is out of reach.
  //
  // Newest first. Roughly a third of a Goodreads shelf carries no finish
  // date, so `addedOn` is the fallback key — without it those books would all
  // collapse to the bottom in arbitrary order.
  const sortKey = (book: CollectionEntry<'books'>) =>
    book.data.finishedOn ?? book.data.addedOn ?? '';

  const all = (await getCollection('books')).sort((a, b) =>
    sortKey(b).localeCompare(sortKey(a)),
  );
  // Everything on the "currently reading" shelf is `current`; the feature
  // slot takes the most recent and the others fall through to the grid.
  const current = all.find((book) => book.data.current);
  const rest = all.filter((book) => book !== current);

  return paginate(rest, {
    pageSize: 48,
    props: { current, total: all.length, all },
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'books'>>;
  current?: CollectionEntry<'books'>;
  total: number;
  all: CollectionEntry<'books'>[];
}

const { page, current, total, all }: Props = Astro.props;
const entry = entryFor(Astro.url.pathname)!;
const first = page.currentPage === 1;

/** The timeline shows the most recent year we have finish dates for. */
const dated = all.filter((book) => Boolean(book.data.finishedOn));
const latestYear = dated.length
  ? Math.max(...dated.map((book) => new Date(book.data.finishedOn!).getUTCFullYear()))
  : new Date().getUTCFullYear();
const timelineItems = dated
  .filter((book) => new Date(book.data.finishedOn!).getUTCFullYear() === latestYear)
  .map((book) => ({ title: book.data.title, finishedOn: book.data.finishedOn! }));
---


<AppShell topBarMeta={`INDEX / ${String(total).padStart(3, '0')}`}>
  <PageHeader
    eyebrow={`${entry.index} / ${entry.context}`}
    title={entry.label}
    summary={entry.summary}
  />

  {
    first && current && (
      <section class="mt-8 flex flex-col gap-3">
        <SectionHeader index="01" title="CURRENT BOOK" />

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,180px)_minmax(0,1fr)]">
          <div class="flex aspect-[2/3] items-center justify-center overflow-hidden rounded-standard border border-line bg-well">
            {current.data.cover ? (
              <img
                src={withBase(current.data.cover)}
                alt={`${current.data.title} cover`}
                class="h-full w-full object-cover"
                decoding="async"
              />
            ) : (
              <span class="type-micro">BOOK COVER</span>
            )}
          </div>

          <div class="flex flex-col gap-2">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div class="flex flex-col gap-0.5">
                <h3 class="type-subhead">
                  <a
                    href={withBase(`/books/${current.id}`)}
                    class="transition-opacity duration-[var(--duration-base)] ease-[var(--ease-technical)] hover:opacity-80"
                  >
                    {current.data.title}
                  </a>
                </h3>
                <p class="type-caption">{current.data.author}</p>
              </div>
              <StatusLabel status={current.data.status} />
            </div>

            <div class="flex flex-wrap items-center gap-1.5">
              <StarRating rating={current.data.rating} size="md" showValue />
              <span class="type-meta">{current.data.source}</span>
            </div>

            {current.data.thought ? (
              <p class="type-body">{current.data.thought}</p>
            ) : (
              <p class="type-fine">No thoughts written down yet.</p>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    first && timelineItems.length > 0 && (
      <section class="mt-8 flex flex-col gap-3">
        <SectionHeader index={current ? '02' : '01'} title="READING TIMELINE" />
        <div class="rounded-standard border border-line bg-panel p-3">
          <ReadingTimeline year={latestYear} items={timelineItems} />
        </div>
      </section>
    )
  }

  <section class="mt-8 flex flex-col gap-3">
    <SectionHeader
      index={first ? (current ? '03' : '02') : '01'}
      title={
        first
          ? `RECENTLY READ / ${String(page.total).padStart(3, '0')} ITEMS`
          : `READING LOG / PAGE ${page.currentPage} OF ${page.lastPage}`
      }
    />
    {/*
      Four to a row on wide screens rather than three: the cards are the
      compact density and the covers are portrait, so at the old width most
      of a card was empty panel beside a tall image.
    */}
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
      {
        page.data.map((book) => (
          <EditorialCard
            kicker={`READ / ${book.data.finishedOn?.slice(0, 4) ?? '—'}`}
            title={book.data.title}
            subtitle={book.data.author}
            summary={book.data.thought}
            density="compact"
            href={withBase(`/books/${book.id}`)}
            action="ENTRY →"
            mediaLabel="BOOK COVER"
            mediaAspect="portrait"
            image={book.data.cover}
            imageAlt={book.data.cover ? `${book.data.title} cover` : ''}
          >
            {/*
              No status label: every book on the shelf is `archive`, so the
              pill said nothing and, on a card this width, pushed the kicker
              onto a second line. The detail page still carries it.

              No source either — all of these came from Goodreads. The
              rating is the only metadata on the card worth its line.
            */}
            <StarRating slot="meta" rating={book.data.rating} />
          </EditorialCard>
        ))
      }
    </div>
  </section>

  <Pager page={page} label="Reading log pages" />
</AppShell>
