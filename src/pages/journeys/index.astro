---
import { getCollection } from 'astro:content';
import AppShell from '@/layouts/AppShell.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import StatusLabel from '@/components/ui/StatusLabel.astro';
import Filmstrip from '@/components/ui/Filmstrip.astro';
import { entryFor } from '@/config/site';

/**
 * Journeys — Flickr albums, newest first, each a scrollable filmstrip whose
 * last frame opens the full album on Flickr.
 *
 * This section was LAB, which had no content model and an honest empty state.
 * The route still resolves: astro.config.mjs redirects /lab here.
 *
 * Not paginated. Each album contributes one row of at most ten thumbnails
 * rather than a card per photo, so the page grows a row at a time — an order
 * of magnitude slower than the games and books indexes did.
 *
 * There are no album pages. Only a handful of each album is imported, so a
 * detail page would add a route to show the same photos again; the last frame
 * of each strip goes to the full album on Flickr instead.
 */
const entry = entryFor('/journeys')!;
const albums = (await getCollection('albums')).sort((a, b) => b.data.index - a.data.index);

const totalPhotos = albums.reduce((sum, album) => sum + album.data.photoCount, 0);
---

<AppShell topBarMeta={`ALBUMS / ${String(albums.length).padStart(3, '0')}`}>
  <PageHeader
    eyebrow={`${entry.index} / ${entry.context}`}
    title={entry.label}
    summary={entry.summary}
  />

  {
    albums.length === 0 ? (
      <div class="mt-8 flex flex-col items-start gap-2 rounded-standard border border-line bg-panel p-3">
        <div class="flex items-center gap-2">
          <StatusLabel status="draft" label="EMPTY" />
          <p class="type-meta">NO ALBUMS YET</p>
        </div>
        <p class="type-fine max-w-prose">
          Albums arrive from Flickr when <code>npm run albums:sync</code> runs.
          Nothing has come through yet.
        </p>
      </div>
    ) : (
      <div class="mt-8 flex flex-col gap-8">
        {albums.map((album) => (
          <section class="flex flex-col gap-3">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <SectionHeader
                index={String(album.data.index).padStart(2, '0')}
                title={album.data.title}
              />
              <p class="type-meta">{album.data.photoCount} PHOTOS</p>
            </div>

            {album.data.description && (
              <p class="type-fine max-w-prose">{album.data.description}</p>
            )}

            <Filmstrip
              photos={album.data.photos}
              albumTitle={album.data.title}
              photoCount={album.data.photoCount}
              albumUrl={album.data.flickrUrl}
            />
          </section>
        ))}
      </div>
    )
  }

  {
    albums.length > 0 && (
      <p class="type-meta mt-8">
        {albums.length} ALBUMS / {totalPhotos} PHOTOS
      </p>
    )
  }
</AppShell>
