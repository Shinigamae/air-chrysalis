---
import { getCollection } from 'astro:content';
import AppShell from '@/layouts/AppShell.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import StatusLabel from '@/components/ui/StatusLabel.astro';
import Filmstrip from '@/components/ui/Filmstrip.astro';
import { entryFor, withBase } from '@/config/site';

/**
 * Journeys — Flickr albums, newest first, each as a scrollable filmstrip over
 * a link to its own page.
 *
 * This section was LAB, which had no content model and an honest empty state.
 * The route still resolves: astro.config.mjs redirects /lab here.
 *
 * Not paginated. Each album contributes one row of at most twelve thumbnails
 * rather than a card per photo, so the page grows a row at a time — an order
 * of magnitude slower than the games and books indexes did.
 */
const entry = entryFor('/journeys')!;
const albums = (await getCollection('albums')).sort((a, b) => b.data.index - a.data.index);

const totalPhotos = albums.reduce((sum, album) => sum + album.data.photoCount, 0);

/** "MAR 2024" or "MAR 2024 — JUN 2024", from the photos' own EXIF dates. */
function when(album: (typeof albums)[number]) {
  const month = (iso?: string) =>
    iso
      ? new Date(iso).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' }).toUpperCase()
      : null;
  const from = month(album.data.takenFrom ?? album.data.createdOn);
  const to = month(album.data.takenTo);
  if (!from) return '';
  return to && to !== from ? `${from} — ${to}` : from;
}
---

<AppShell topBarMeta={`ALBUMS / ${String(albums.length).padStart(3, '0')}`}>
  <PageHeader
    eyebrow={`${entry.index} / ${entry.context}`}
    title={entry.label}
    summary={entry.summary}
  />

  {
    albums.length === 0 ? (
      <div class="mt-8 flex flex-col items-start gap-2 rounded-standard border border-line bg-panel p-3">
        <div class="flex items-center gap-2">
          <StatusLabel status="draft" label="EMPTY" />
          <p class="type-meta">NO ALBUMS YET</p>
        </div>
        <p class="type-fine max-w-prose">
          Albums arrive from Flickr when <code>npm run albums:sync</code> runs.
          Nothing has come through yet.
        </p>
      </div>
    ) : (
      <div class="mt-8 flex flex-col gap-8">
        {albums.map((album) => (
          <section class="flex flex-col gap-3">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <SectionHeader
                index={String(album.data.index).padStart(2, '0')}
                title={album.data.title}
              />
              <p class="type-meta">
                {when(album)}
                {when(album) && ' / '}
                {album.data.photoCount} PHOTOS
              </p>
            </div>

            {album.data.description && (
              <p class="type-fine max-w-prose">{album.data.description}</p>
            )}

            <Filmstrip photos={album.data.photos} albumTitle={album.data.title} />

            <a
              href={withBase(`/journeys/${album.id}`)}
              class="type-micro self-start text-signal transition-opacity duration-[var(--duration-base)] ease-[var(--ease-technical)] hover:opacity-80"
            >
              OPEN ALBUM →
            </a>
          </section>
        ))}
      </div>
    )
  }

  {
    albums.length > 0 && (
      <p class="type-meta mt-8">
        {albums.length} ALBUMS / {totalPhotos} PHOTOS
      </p>
    )
  }
</AppShell>
