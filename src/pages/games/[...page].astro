---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection } from 'astro:content';
import AppShell from '@/layouts/AppShell.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import SpecList from '@/components/ui/SpecList.astro';
import StatusLabel from '@/components/ui/StatusLabel.astro';
import GameGrid from '@/components/ui/GameGrid.astro';
import PlatformTags from '@/components/ui/PlatformTags.astro';
import { entryFor, withBase } from '@/config/site';
import {
  PAGE_SIZE,
  byRecency,
  facetsFor,
  imageOf,
  ratingOf,
  type Game,
} from '@/config/games';

/**
 * Games — Figma "03 — Content Systems" panel B (11:88-11:97).
 *
 * "CURRENTLY PLAYING" is the feature block: screenshots as the visual anchor,
 * metadata and a review excerpt beside them. Everything else is the index.
 *
 * Paginated because the log is imported wholesale from PSN and runs to a few
 * hundred titles — as one page it was 406KB of HTML and as many cover images.
 * The feature block belongs to right now, so it stays on the first page.
 */
export const getStaticPaths = (async ({ paginate }) => {
  const all = (await getCollection('games')).sort(byRecency);
  const current = all.find((game) => game.data.current);
  const rest = all.filter((game) => game !== current);

  return paginate(rest, {
    pageSize: PAGE_SIZE,
    props: { current, rest },
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Game>;
  current?: Game;
  rest: Game[];
}

const { page, current, rest }: Props = Astro.props;
const entry = entryFor('/games')!;
const first = page.currentPage === 1;
---

<AppShell topBarMeta={`INDEX / ${String(rest.length + 1).padStart(3, '0')}`}>
  <PageHeader
    eyebrow={`${entry.index} / ${entry.context}`}
    title={entry.label}
    summary={entry.summary}
  />

  {
    first && current && (
      <section class="mt-8 flex flex-col gap-3">
        <SectionHeader index="01" title="CURRENTLY PLAYING" />

        <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
          {/* Screenshots carry the emotion; metadata sits beside them. */}
          <div class="flex aspect-[16/9] items-center justify-center overflow-hidden rounded-standard border border-line bg-well">
            {imageOf(current) ? (
              <img
                src={withBase(imageOf(current)!)}
                alt={current.data.title}
                class="h-full w-full object-cover"
                decoding="async"
              />
            ) : (
              <span class="type-micro">SCREENSHOTS</span>
            )}
          </div>

          <div class="flex flex-col gap-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="type-subhead">
                <a
                  href={withBase(`/games/${current.id}`)}
                  class="transition-opacity duration-[var(--duration-base)] ease-[var(--ease-technical)] hover:opacity-80"
                >
                  {current.data.title}
                </a>
              </h3>
              <StatusLabel status={current.data.status} />
            </div>

            <div class="flex flex-wrap items-center gap-1">
              <PlatformTags platform={current.data.platform} size="md" />
              <span class="type-meta">{current.data.year}</span>
            </div>

            <SpecList
              items={[
                { label: 'PROGRESS', value: `${current.data.progress}%` },
                { label: 'RATING', value: ratingOf(current.data.rating) },
                {
                  label: 'STATUS',
                  value: current.data.playStatus.replace('-', ' ').toUpperCase(),
                },
              ]}
            />

            <div class="flex flex-col gap-1">
              <p class="type-micro text-signal">REVIEW EXCERPT</p>
              {current.data.review ? (
                <p class="type-fine">{current.data.review}</p>
              ) : (
                <p class="type-fine">No write-up yet.</p>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <GameGrid
    page={page}
    index={first && current ? '02' : '01'}
    title={first ? 'RECENT GAMES' : `RECENT GAMES / PAGE ${page.currentPage} OF ${page.lastPage}`}
    facets={facetsFor(rest, 'all')}
  />
</AppShell>
