---
import '@/styles/globals.css';
import { site, entryFor, stripBase, withBase } from '@/config/site';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import MobileNavigation from '@/components/layout/MobileNavigation.astro';
import TopBar from '@/components/layout/TopBar.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import AdminBar from '@/components/edit/AdminBar';
import { hasBackend } from '@/lib/api';

/**
 * The application shell. Every route renders through here.
 *
 * Desktop: horizontal header (Figma "02 — Homepage" › Header) with an
 * optional page-context strip beneath it. Below `md` the header is replaced
 * by MobileNavigation — a different structure, not a narrower one.
 */
interface Props {
  /** Page title for <title> and, when set, the context strip centre. */
  title?: string;
  description?: string;
  /** Right-hand metadata in the context strip, e.g. "INDEX / 014". */
  topBarMeta?: string;
  /** Home opts out so the hero sits directly on the canvas. */
  showTopBar?: boolean;
}

const {
  title,
  description = site.description,
  topBarMeta,
  showTopBar = true,
} = Astro.props;

const pathname = stripBase(Astro.url.pathname);
const entry = entryFor(pathname);

const documentTitle = title
  ? `${title} — ${site.name}`
  : entry
    ? `${entry.label} — ${site.name}`
    : site.name;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090B" />
    {/*
      Keep the archive out of search results for now.

      This tag, not a robots.txt, is what does the work here. robots.txt is
      only honoured at the origin root, and on GitHub Pages this site is a
      project page under /air-chrysalis/ — the root belongs to the
      shinigamae.github.io repository, so a robots.txt committed here would
      be served at a path every crawler ignores. `noindex` travels with the
      page and needs no such cooperation.

      `nofollow` is here too so a crawler that reaches one page does not
      treat it as a directory of the other 482.

      To make the site public: delete this tag and re-add the sitemap
      integration in astro.config.mjs.
    */}
    <meta name="robots" content="noindex, nofollow" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={withBase('/rss.xml')}
    />
    <title>{documentTitle}</title>
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="type-nav sr-only-focusable absolute left-2 top-2 z-60 rounded-compact border border-signal bg-panel px-1 py-1 text-signal"
    >
      SKIP TO CONTENT
    </a>

    <MobileNavigation pathname={pathname} />
    <SiteHeader pathname={pathname} />

    {
      showTopBar && entry && (
        <TopBar
          context={`${entry.index} / ${entry.label}`}
          title={title}
          meta={topBarMeta}
        />
      )
    }

    <main id="main" class="layout-container flex-1 py-5 md:py-8">
      <slot />
    </main>

    <SiteFooter />

    {/*
      Edit mode's switch. `client:idle` rather than `client:load` because it is
      never the reason anyone opened the page — it waits for the browser to be
      done with the content first.

      It renders null for every visitor: with PUBLIC_API_URL unset it returns
      immediately, and with it set it asks /api/me once and returns null for
      anyone who is not the admin. See src/components/edit/AdminBar.tsx.
    */}
    {/*
      An empty PUBLIC_API_URL means "no backend" (BACKEND.md §10.2), and it has to
      mean the code is *absent* rather than that it renders null — an island Astro
      emits is an island every reader downloads and hydrates. Gated here, a build
      with no API ships not one byte of edit mode.
    */}
    {hasBackend && <AdminBar client:idle />}
  </body>
</html>
